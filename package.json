{
  "name": "manent-monorepo",
  "version": "0.0.1",
  "description": "Monorepo for Manent \u2014 file-first, git-versioned memory for AI agents.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/colopisalvatore/manent.git"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -b packages/spec packages/core packages/retrieval packages/curate packages/eval packages/lint packages/server packages/cli",
    "smoke": "node scripts/smoke.mjs",
    "probe": "node scripts/mcp-probe.mjs",
    "test:oauth": "node scripts/oauth-test.mjs",
    "test:era": "node scripts/era-test.mjs",
    "eval": "node scripts/eval-vault.mjs --golden eval/golden-aios.json",
    "eval:gate": "node scripts/eval-vault.mjs --golden eval/golden-aios.json --retriever bm25 --baseline eval/baseline-bm25.json",
    "lint:fixture": "node packages/cli/dist/index.js lint eval/fixture-vault --strict-content --strict-links --audiences tech,product",
    "check:published": "node scripts/published-check.mjs",
    "eval:fixture": "node packages/cli/dist/index.js eval eval/fixture-vault --golden eval/golden-fixture.json --retriever bm25 --baseline eval/baseline-fixture-bm25.json",
    "tune": "node scripts/tune-retrieval.mjs",
    "eval:fused": "node scripts/eval-vault.mjs --golden eval/golden-aios.json --retriever fused",
    "tune:fusion": "node scripts/tune-fusion.mjs",
    "test:warmup": "node scripts/warmup-test.mjs",
    "test:write": "node scripts/write-test.mjs",
    "test:links": "node scripts/links-test.mjs",
    "test:gaps": "node scripts/gaps-test.mjs",
    "test:acl": "node scripts/acl-test.mjs",
    "test:reload": "node scripts/reload-test.mjs",
    "test:promote": "node scripts/promote-test.mjs",
    "test:curate": "node scripts/curate-test.mjs",
    "test:tasks": "node scripts/tasks-test.mjs",
    "test:apps": "node scripts/apps-test.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.5.4"
  },
  "workspaces": [
    "packages/*"
  ],
  "private": true
}
